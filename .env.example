# =====================================================================
# TEMPLATE DE CONFIGURAÇÃO DE AMBIENTE (.env.example) - AGILISTA API
# Copie este arquivo para .env e preencha com suas configurações locais:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/Mac)
#
# AVISO: O arquivo .env NUNCA deve ser commitado no Git (já está no .gitignore).
# =====================================================================

# ---------------------------------------------------------------------
# OPÇÃO 1: PostgreSQL Local (Instância já instalada na máquina)
# Formato: postgresql://<usuario>:<senha>@<host>:<porta>/<nome_do_banco>
# Exemplo de comando para criar o banco: createdb agilista_db
# ---------------------------------------------------------------------
# DATABASE_URL=postgresql://<usuario>:<sua_senha>@localhost:5432/agilista_db

# ---------------------------------------------------------------------
# OPÇÃO 2: Render / Supabase (PostgreSQL na Nuvem)
# Copie a Connection String (URI) no painel do Render ou Supabase:
# (O validador em app/config.py converte automaticamente para postgresql+psycopg://)
# ---------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres.<project_ref>:<sua_senha>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# ---------------------------------------------------------------------
# OPÇÃO 3: Fallback Didático SQLite Local (arquivo embutido)
# Padrão ativo para desenvolvimento rápido sem serviço PostgreSQL local
# ---------------------------------------------------------------------
DATABASE_URL=sqlite:///./agilista.db

# ---------------------------------------------------------------------
# Configurações Gerais da Aplicação
# ---------------------------------------------------------------------
APP_NAME=AgiLista API
ENVIRONMENT=development
DEBUG=true

# ---------------------------------------------------------------------
# Configurações de Segurança e Autenticação JWT
# Em produção (Render), gere uma chave secreta forte nas variáveis de ambiente
# ---------------------------------------------------------------------
JWT_SECRET_KEY=coloque-uma-chave-secreta-forte-aqui
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30